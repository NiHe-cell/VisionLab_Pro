{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev-debug",
      "displayName": "Debug CPU (Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "VISIONLAB_ENABLE_TENSORRT": "OFF",
        "VISIONLAB_ENABLE_WARNINGS": "OFF"
      }
    },
    {
      "name": "dev-debug-trt",
      "inherits": "dev-debug",
      "displayName": "Debug TensorRT (Ninja)",
      "cacheVariables": {
        "VISIONLAB_ENABLE_TENSORRT": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev-debug",
      "configurePreset": "dev-debug"
    },
    {
      "name": "dev-debug-trt",
      "configurePreset": "dev-debug-trt"
    }
  ]
}
